{
  "name": "relay-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Durable grouped terminal conversations and an agent notification inbox. A lightweight Agentrium fork.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "doctor": "node scripts/start.mjs --doctor",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "node scripts/relay-tool.mjs dev",
    "desktop:build": "node scripts/relay-tool.mjs build",
    "tauri": "node scripts/relay-tool.mjs",
    "test": "vitest run",
    "test:startup": "node --test scripts/start.test.mjs",
    "test:connectors": "node --test integrations/notify.test.mjs integrations/providers.test.mjs integrations/relay-mcp.test.mjs",
    "test:native": "node scripts/relay-tool.mjs native-test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
